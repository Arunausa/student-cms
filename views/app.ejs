<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page.replace(/_/g,' ').replace(/\b\w/g,l=>l.toUpperCase()) %> · SMS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --sidebar-bg: #1B1C31;
      --sidebar-hover: #2B2DFB;
      --bg-color: #F4F7FE;
      --text-main: #2B3674;
      --text-muted: #A3AED0;
      --card-radius: 20px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--bg-color); color: var(--text-main); }

    /* Sidebar */
    .sidebar {
      position: fixed; top: 0; left: 0; bottom: 0; width: 280px;
      background: var(--sidebar-bg); color: #fff; padding: 24px 20px;
      display: flex; flex-direction: column; overflow-y: auto; z-index: 100;
    }
    .sidebar-brand {
      display: flex; align-items: center; gap: 12px; margin-bottom: 32px;
    }
    .sidebar-brand .logo {
      width: 40px; height: 40px; border-radius: 10px;
      background: linear-gradient(135deg, #FF9C00, #FFC048);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-weight: 800; font-size: 1.1rem;
    }
    .sidebar-brand span { font-weight: 700; font-size: 1rem; }
    .sidebar-brand small { display: block; font-size: .72rem; color: #A3AED0; font-weight: 400; }
    .nav-header {
      font-size: .68rem; text-transform: uppercase; letter-spacing: .08em;
      color: #64748B; padding: 16px 12px 6px; font-weight: 600;
    }
    .nav-link {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 10px; color: #CBD5E1;
      font-weight: 500; font-size: .88rem; transition: all .2s;
      text-decoration: none;
    }
    .nav-link:hover { background: rgba(99,102,241,.15); color: #fff; }
    .nav-link.active { background: var(--sidebar-hover); color: #fff; }
    .nav-link i { width: 20px; text-align: center; font-size: .9rem; }
    .sidebar-bottom { margin-top: auto; }
    .trophy-card {
      background: linear-gradient(135deg, rgba(99,102,241,.15), rgba(139,92,246,.1));
      border-radius: 14px; padding: 16px; text-align: center; margin-bottom: 16px;
    }
    .trophy-card .emoji { font-size: 2rem; margin-bottom: 6px; }
    .trophy-card p { color: #CBD5E1; font-size: .8rem; margin: 0; }
    .trophy-card strong { color: #fff; }
    .nav-link.logout { color: #F87171; }
    .nav-link.logout:hover { background: rgba(248,113,113,.12); }

    /* Main */
    .main-content { margin-left: 280px; min-height: 100vh; }
    .topbar {
      background: #fff; padding: 16px 28px; display: flex;
      align-items: center; justify-content: space-between;
      border-bottom: 1px solid #EDF2F7;
    }
    .topbar-left h5 { font-weight: 700; color: var(--text-main); margin: 0; }
    .topbar-left small { color: var(--text-muted); font-size: .82rem; }
    .topbar-right { display: flex; align-items: center; gap: 14px; }
    .topbar-right .search-box {
      background: #F8FAFC; border: 1px solid #EDF2F7; border-radius: 12px;
      padding: 8px 14px; font-size: .85rem; width: 200px; outline: none;
    }
    .topbar-right .icon-btn {
      width: 38px; height: 38px; border-radius: 10px; border: 1px solid #EDF2F7;
      display: flex; align-items: center; justify-content: center;
      background: #fff; color: var(--text-muted); cursor: pointer; position: relative;
    }
    .topbar-right .badge-dot {
      position: absolute; top: 6px; right: 6px; width: 8px; height: 8px;
      background: #FF4C61; border-radius: 50%;
    }
    .profile-btn {
      display: flex; align-items: center; gap: 8px; cursor: pointer;
    }
    .profile-btn img { width: 36px; height: 36px; border-radius: 50%; }
    .profile-btn .name { font-weight: 600; font-size: .85rem; color: var(--text-main); }
    .profile-btn .role { font-size: .72rem; color: var(--text-muted); }

    .page-content { padding: 24px 28px; }

    /* Cards */
    .card-custom {
      background: #fff; border-radius: var(--card-radius); padding: 22px;
      box-shadow: 0 4px 20px rgba(0,0,0,.04); border: none;
    }
    .metric-card {
      border-radius: 16px; padding: 20px 22px; color: #fff; position: relative; overflow: hidden;
    }
    .metric-card .icon-circle {
      width: 46px; height: 46px; border-radius: 50%;
      background: rgba(255,255,255,.2); display: flex;
      align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .metric-card .metric-value { font-size: 1.8rem; font-weight: 800; }
    .metric-card .metric-label { font-size: .8rem; opacity: .85; }

    .bg-purple { background: linear-gradient(135deg, #6366F1, #818CF8); }
    .bg-green { background: linear-gradient(135deg, #00B87C, #34D399); }
    .bg-orange { background: linear-gradient(135deg, #FF9C00, #FFC048); }
    .bg-blue { background: linear-gradient(135deg, #0075FF, #60A5FA); }
    .bg-pink { background: linear-gradient(135deg, #FF4C61, #FB7185); }

    /* Tables */
    .table { color: var(--text-main); }
    .table thead th {
      font-size: .78rem; text-transform: uppercase; letter-spacing: .04em;
      color: var(--text-muted); font-weight: 600; border-bottom: 2px solid #EDF2F7;
    }
    .table td { vertical-align: middle; font-size: .88rem; }
    .badge-status {
      padding: 5px 12px; border-radius: 8px; font-size: .75rem; font-weight: 600;
    }
    .badge-approved { background: #D1FAE5; color: #065F46; }
    .badge-declined { background: #FEE2E2; color: #991B1B; }
    .badge-pending { background: #FEF3C7; color: #92400E; }

    .chart-wrap { position: relative; height: 280px; }
    .chart-wrap-sm { position: relative; height: 220px; }

    /* Form */
    .form-control, .form-select {
      border-radius: 12px; border: 1px solid #E2E8F0;
      background: #F8FAFC; padding: 10px 14px; font-size: .9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: #6366F1; box-shadow: 0 0 0 .15rem rgba(99,102,241,.15);
      background: #fff;
    }
    .btn-indigo {
      background: #6366F1; color: #fff; border: none; border-radius: 12px;
      padding: 10px 22px; font-weight: 600;
    }
    .btn-indigo:hover { background: #4F46E5; color: #fff; }
    .modal-content { border-radius: 16px; border: none; }
    .modal-header { border-bottom: 1px solid #EDF2F7; }
    .score-card {
      border-radius: 16px; background: #fff; padding: 24px;
      box-shadow: 0 4px 16px rgba(0,0,0,.05); text-align: center;
    }
    .score-card .score-value { font-size: 2.4rem; font-weight: 800; color: #6366F1; }
  </style>
</head>
<body>

<!-- ====== SIDEBAR ====== -->
<aside class="sidebar">
  <div class="sidebar-brand">
    <div class="logo">S</div>
    <div><span>SMS</span><small>Management System</small></div>
  </div>

  <div class="nav-header">MAIN</div>
  <a class="nav-link <%= page === 'dashboard' ? 'active' : '' %>" href="/app?page=dashboard">
    <i class="fas fa-th-large"></i> Dashboard
  </a>

  <% if (user.role === 'admin' || user.role === 'staff') { %>
    <div class="nav-header">ACADEMIC</div>
    <% if (user.role === 'admin') { %>
      <a class="nav-link <%= page === 'courses' ? 'active' : '' %>" href="/app?page=courses">
        <i class="fas fa-graduation-cap"></i> Courses
      </a>
      <a class="nav-link <%= page === 'subjects' ? 'active' : '' %>" href="/app?page=subjects">
        <i class="fas fa-book-open"></i> Subjects
      </a>
    <% } %>
    <a class="nav-link <%= (page === 'manage_attendance' || page === 'take_attendance') ? 'active' : '' %>" href="/app?page=<%= user.role === 'admin' ? 'manage_attendance' : 'take_attendance' %>">
      <i class="fas fa-clipboard-check"></i> Attendance
    </a>
    <a class="nav-link <%= page === 'manage_exams' ? 'active' : '' %>" href="/app?page=manage_exams">
      <i class="fas fa-file-alt"></i> Exams
    </a>
  <% } %>

  <% if (user.role === 'admin') { %>
    <div class="nav-header">USERS</div>
    <a class="nav-link <%= page === 'manage_staff' ? 'active' : '' %>" href="/app?page=manage_staff">
      <i class="fas fa-user-tie"></i> Staff
    </a>
    <a class="nav-link <%= page === 'manage_students' ? 'active' : '' %>" href="/app?page=manage_students">
      <i class="fas fa-user-graduate"></i> Students
    </a>
  <% } %>

  <% if (user.role === 'admin') { %>
    <div class="nav-header">REQUESTS</div>
    <a class="nav-link <%= page === 'notifications' ? 'active' : '' %>" href="/app?page=notifications">
      <i class="fas fa-bell"></i> Leave Requests
    </a>
    <a class="nav-link <%= page === 'notify' ? 'active' : '' %>" href="/app?page=notify">
      <i class="fas fa-bullhorn"></i> Broadcast
    </a>
  <% } %>

  <% if (user.role === 'staff') { %>
    <div class="nav-header">OTHERS</div>
    <a class="nav-link <%= page === 'apply_leave' ? 'active' : '' %>" href="/app?page=apply_leave">
      <i class="fas fa-paper-plane"></i> Apply Leave
    </a>
    <a class="nav-link <%= page === 'staff_notifs' ? 'active' : '' %>" href="/app?page=staff_notifs">
      <i class="fas fa-bell"></i> Notices
    </a>
    <a class="nav-link <%= page === 'view_attendance' ? 'active' : '' %>" href="/app?page=view_attendance">
      <i class="fas fa-calendar-check"></i> Attendance Logs
    </a>
  <% } %>

  <% if (user.role === 'student') { %>
    <div class="nav-header">ACADEMIC</div>
    <a class="nav-link <%= page === 'my_attendance' ? 'active' : '' %>" href="/app?page=my_attendance">
      <i class="fas fa-calendar-check"></i> My Attendance
    </a>
    <a class="nav-link <%= page === 'exam_results' ? 'active' : '' %>" href="/app?page=exam_results">
      <i class="fas fa-trophy"></i> Exam Results
    </a>
    <div class="nav-header">OTHERS</div>
    <a class="nav-link <%= page === 'apply_leave' ? 'active' : '' %>" href="/app?page=apply_leave">
      <i class="fas fa-paper-plane"></i> Apply Leave
    </a>
    <a class="nav-link <%= page === 'student_notifs' ? 'active' : '' %>" href="/app?page=student_notifs">
      <i class="fas fa-bell"></i> Notices
    </a>
    <a class="nav-link <%= page === 'feedback' ? 'active' : '' %>" href="/app?page=feedback">
      <i class="fas fa-comment-dots"></i> Feedback
    </a>
  <% } %>

  <div class="sidebar-bottom">
    <div class="trophy-card">
      <div class="emoji">🏆</div>
      <p><strong>Keep it up!</strong><br/>Stay consistent.</p>
    </div>
    <a class="nav-link logout" href="/logout">
      <i class="fas fa-sign-out-alt"></i> Logout
    </a>
  </div>
</aside>

<!-- ====== MAIN ====== -->
<div class="main-content">
  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-left">
      <h5><%= page.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></h5>
      <small>Welcome, <strong><%= user.full_name %></strong></small>
    </div>
    <div class="topbar-right">
      <input type="text" class="search-box" placeholder="Search..." />
      <div class="icon-btn"><i class="far fa-calendar"></i></div>
      <div class="icon-btn">
        <i class="fas fa-bell"></i>
        <span class="badge-dot"></span>
      </div>
      <div class="profile-btn">
        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.full_name) %>&background=6366F1&color=fff&size=80" alt="avatar" />
        <div>
          <div class="name"><%= user.full_name %></div>
          <div class="role"><%= user.role %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Page Content -->
  <div class="page-content">

    <% if (success_msg) { %>
      <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <%= success_msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- ===== DASHBOARD ===== -->
    <% if (page === 'dashboard') { %>
      <div class="row g-3 mb-4">
        <div class="col">
          <div class="metric-card bg-purple d-flex align-items-center justify-content-between">
            <div><div class="metric-value"><%= typeof total_courses !== 'undefined' ? total_courses : 12 %></div><div class="metric-label">Total Courses</div></div>
            <div class="icon-circle"><i class="fas fa-graduation-cap"></i></div>
          </div>
        </div>
        <div class="col">
          <div class="metric-card bg-green d-flex align-items-center justify-content-between">
            <div><div class="metric-value"><%= typeof total_subjects !== 'undefined' ? total_subjects : 24 %></div><div class="metric-label">Subjects</div></div>
            <div class="icon-circle"><i class="fas fa-book-open"></i></div>
          </div>
        </div>
        <div class="col">
          <div class="metric-card bg-orange d-flex align-items-center justify-content-between">
            <div>
              <div class="metric-value">
                <% if (user.role === 'student' && typeof total_total !== 'undefined' && total_total > 0) { %>
                  <%= Math.round((total_present / total_total) * 100) %>%
                <% } else { %>
                  <%= typeof att_count !== 'undefined' ? att_count : 0 %>
                <% } %>
              </div>
              <div class="metric-label">Attendance</div>
            </div>
            <div class="icon-circle"><i class="fas fa-clipboard-check"></i></div>
          </div>
        </div>
        <div class="col">
          <div class="metric-card bg-blue d-flex align-items-center justify-content-between">
            <div><div class="metric-value"><%= typeof total_students !== 'undefined' ? total_students : 85 %></div><div class="metric-label">Students</div></div>
            <div class="icon-circle"><i class="fas fa-user-graduate"></i></div>
          </div>
        </div>
        <div class="col">
          <div class="metric-card bg-pink d-flex align-items-center justify-content-between">
            <div><div class="metric-value"><%= typeof total_staff !== 'undefined' ? total_staff : 8 %></div><div class="metric-label">Staff</div></div>
            <div class="icon-circle"><i class="fas fa-user-tie"></i></div>
          </div>
        </div>
      </div>
      <div class="row g-3">
        <div class="col-lg-8">
          <div class="card-custom">
            <h6 class="fw-bold mb-3"><i class="fas fa-chart-line me-2 text-primary"></i>Attendance Overview</h6>
            <div class="chart-wrap"><canvas id="attendanceLineChart"></canvas></div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="card-custom h-100">
            <h6 class="fw-bold mb-3"><i class="fas fa-chart-pie me-2 text-primary"></i>Performance Metrics</h6>
            <div class="chart-wrap-sm"><canvas id="performanceDoughnut"></canvas></div>
          </div>
        </div>
      </div>
      <script>
        new Chart(document.getElementById('attendanceLineChart'), {
          type: 'line',
          data: {
            labels: Array.from({length:31},(_,i)=> (i+1)+' May'),
            datasets: [
              { label:'Present', data:[28,30,27,25,29,31,26,28,30,27,25,29,31,26,28,30,27,25,29,31,26,28,30,27,25,29,31,26,28,30,27], borderColor:'#10b981', backgroundColor:'rgba(16,185,129,.1)', tension:.4, fill:true },
              { label:'Absent', data:[5,3,6,8,4,2,7,5,3,6,8,4,2,7,5,3,6,8,4,2,7,5,3,6,8,4,2,7,5,3,6], borderColor:'#ef4444', backgroundColor:'rgba(239,68,68,.1)', tension:.4, fill:true }
            ]
          },
          options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } }, scales:{ y:{ beginAtZero:true } } }
        });
        new Chart(document.getElementById('performanceDoughnut'), {
          type: 'doughnut',
          data: {
            labels: ['Excellent','Good','Needs Work'],
            datasets: [{ data:[45,35,20], backgroundColor:['#10b981','#3b82f6','#ef4444'], borderWidth:0 }]
          },
          options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } } }
        });
      </script>

    <!-- ===== COURSES / SUBJECTS ===== -->
    <% } else if (page === 'courses' || page === 'subjects') { %>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card-custom">
            <h6 class="fw-bold mb-3"><i class="fas fa-plus-circle me-2"></i>Add <%= page === 'courses' ? 'Course' : 'Subject' %></h6>
            <form method="POST" action="/app?page=<%= page %>">
              <input type="hidden" name="action" value="<%= page === 'courses' ? 'add_course' : 'add_subject' %>" />
              <div class="mb-3">
                <input class="form-control" name="name" placeholder="<%= page === 'courses' ? 'Course name' : 'Subject name' %>" required />
              </div>
              <% if (page === 'subjects') { %>
                <div class="mb-3">
                  <select class="form-select" name="course_id" required>
                    <option value="">Select course</option>
                    <% (courses || []).forEach(c => { %>
                      <option value="<%= c._id %>"><%= c.name %></option>
                    <% }) %>
                  </select>
                </div>
              <% } %>
              <button class="btn btn-indigo w-100 rounded-3" type="submit">Save</button>
            </form>
          </div>
        </div>
        <div class="col-md-8">
          <div class="card-custom">
            <h6 class="fw-bold mb-3"><%= page === 'courses' ? 'Courses' : 'Subjects' %></h6>
            <table class="table">
              <thead>
                <tr>
                  <th>#</th><th>Name</th>
                  <% if (page === 'subjects') { %><th>Course</th><% } %>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% const items = page === 'courses' ? (courses || []) : (subjects || []); %>
                <% items.forEach((item, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td><%= item.name %></td>
                    <% if (page === 'subjects') { %>
                      <td><%= item.course_id ? item.course_id.name : '—' %></td>
                    <% } %>
                    <td class="text-end">
                      <a href="/app?page=<%= page %>&delete=1&table=<%= page %>&id=<%= item._id %>" class="text-danger" onclick="return confirm('Delete?')">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
                <% if (items.length === 0) { %>
                  <tr><td colspan="<%= page === 'subjects' ? 4 : 3 %>" class="text-center text-muted py-4">No records found.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    <!-- ===== MANAGE STAFF / STUDENTS ===== -->
    <% } else if (page === 'manage_staff' || page === 'manage_students') { %>
      <% const isStaff = page === 'manage_staff'; %>
      <% const list = isStaff ? (staffs || []) : (students || []); %>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><%= isStaff ? 'Staff Members' : 'Students' %></h6>
        <button class="btn btn-indigo rounded-3" data-bs-toggle="modal" data-bs-target="#addUserModal">
          <i class="fas fa-plus me-1"></i> Add New
        </button>
      </div>
      <div class="card-custom">
        <table class="table">
          <thead>
            <tr><th>Avatar</th><th>Name</th><th>Email</th><th>Gender</th><% if (!isStaff) { %><th>Course</th><% } %><th class="text-end">Action</th></tr>
          </thead>
          <tbody>
            <% list.forEach(u => { %>
              <tr>
                <td><img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.full_name) %>&background=6366F1&color=fff&size=40" width="36" height="36" class="rounded-circle" /></td>
                <td><%= u.full_name %></td>
                <td><%= u.email %></td>
                <td><%= u.gender || '—' %></td>
                <% if (!isStaff) { %><td><%= u.course_id ? u.course_id.name : '—' %></td><% } %>
                <td class="text-end">
                  <a href="/app?page=<%= page %>&delete=1&table=<%= isStaff ? 'staff' : 'students' %>&id=<%= u._id %>" class="text-danger" onclick="return confirm('Delete this user?')">
                    <i class="fas fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
            <% if (list.length === 0) { %>
              <tr><td colspan="<%= isStaff ? 5 : 6 %>" class="text-center text-muted py-4">No records found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Add User Modal -->
      <div class="modal fade" id="addUserModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form method="POST" action="/app?page=<%= page %>">
          <input type="hidden" name="action" value="<%= isStaff ? 'add_staff' : 'add_student' %>" />
          <div class="modal-header"><h5 class="modal-title">Add <%= isStaff ? 'Staff' : 'Student' %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
          <div class="modal-body">
            <div class="mb-3"><label class="form-label">Full Name</label><input class="form-control" name="full_name" required /></div>
            <div class="mb-3"><label class="form-label">Email</label><input class="form-control" name="email" type="email" required /></div>
            <div class="mb-3"><label class="form-label">Gender</label>
              <select class="form-select" name="gender"><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select>
            </div>
            <% if (!isStaff) { %>
              <div class="mb-3"><label class="form-label">Course</label>
                <select class="form-select" name="course_id">
                  <option value="">Select</option>
                  <% (courses || []).forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %>
                </select>
              </div>
            <% } %>
            <div class="mb-3"><label class="form-label">Address</label><textarea class="form-control" name="address" rows="2"></textarea></div>
          </div>
          <div class="modal-footer"><button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-indigo rounded-3">Save</button></div>
        </form>
      </div></div></div>

    <!-- ===== ATTENDANCE ===== -->
    <% } else if (page === 'manage_attendance' || page === 'take_attendance') { %>
      <div class="card-custom mb-4">
        <h6 class="fw-bold mb-3"><i class="fas fa-filter me-2"></i>Filter Attendance</h6>
        <form method="GET" action="/app" class="row g-2 align-items-end">
          <input type="hidden" name="page" value="<%= page %>" />
          <div class="col-md-3"><label class="form-label">Date</label><input type="date" class="form-control" name="fetch_date" value="<%= fetch_date || '' %>" required /></div>
          <div class="col-md-3"><label class="form-label">Course</label>
            <select class="form-select" name="fetch_course" required>
              <option value="">Select</option>
              <% (courses || []).forEach(c => { %><option value="<%= c._id %>" <%= fetch_course === c._id.toString() ? 'selected' : '' %>><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="col-md-3"><label class="form-label">Subject</label>
            <select class="form-select" name="fetch_subject" required>
              <option value="">Select</option>
              <% (subjects || []).forEach(s => { %><option value="<%= s._id %>" <%= fetch_subject === s._id.toString() ? 'selected' : '' %>><%= s.name %></option><% }) %>
            </select>
          </div>
          <div class="col-md-3"><button class="btn btn-indigo rounded-3 w-100" type="submit">Fetch</button></div>
        </form>
      </div>

      <% if (fetched_students && fetched_students.length > 0) { %>
        <div class="card-custom">
          <form method="POST" action="/app?page=<%= page %>">
            <input type="hidden" name="action" value="save_attendance" />
            <input type="hidden" name="date" value="<%= fetch_date %>" />
            <input type="hidden" name="course_id" value="<%= fetch_course %>" />
            <input type="hidden" name="subject_id" value="<%= fetch_subject %>" />
            <table class="table">
              <thead><tr><th>#</th><th>Student</th><th>Present</th><th>Absent</th></tr></thead>
              <tbody>
                <% fetched_students.forEach((s, i) => { %>
                  <% const prev = existing_attendance[s._id.toString()]; %>
                  <tr>
                    <td><%= i+1 %></td>
                    <td><%= s.full_name %></td>
                    <td><input type="radio" name="attendance[<%= s._id %>]" value="Present" <%= (!prev || prev === 'Present') ? 'checked' : '' %> /></td>
                    <td><input type="radio" name="attendance[<%= s._id %>]" value="Absent" <%= prev === 'Absent' ? 'checked' : '' %> /></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <button class="btn btn-indigo rounded-3" type="submit">Save Attendance</button>
          </form>
        </div>
      <% } %>

    <!-- ===== MANAGE EXAMS ===== -->
    <% } else if (page === 'manage_exams') { %>
      <div class="card-custom mb-4">
        <h6 class="fw-bold mb-3"><i class="fas fa-filter me-2"></i>Filter</h6>
        <form method="GET" action="/app" class="row g-2 align-items-end">
          <input type="hidden" name="page" value="manage_exams" />
          <div class="col-md-4"><label class="form-label">Course</label>
            <select class="form-select" name="fetch_course" required>
              <option value="">Select</option>
              <% (courses || []).forEach(c => { %><option value="<%= c._id %>" <%= fetch_course === c._id.toString() ? 'selected' : '' %>><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="col-md-4"><label class="form-label">Subject</label>
            <select class="form-select" name="fetch_subject" required>
              <option value="">Select</option>
              <% (subjects || []).forEach(s => { %><option value="<%= s._id %>" <%= fetch_subject === s._id.toString() ? 'selected' : '' %>><%= s.name %></option><% }) %>
            </select>
          </div>
          <div class="col-md-4"><button class="btn btn-indigo rounded-3 w-100" type="submit">Fetch Students</button></div>
        </form>
      </div>

      <% if (exam_students && exam_students.length > 0) { %>
        <div class="card-custom">
          <form method="POST" action="/app?page=manage_exams">
            <input type="hidden" name="action" value="save_scores" />
            <input type="hidden" name="subject_id" value="<%= fetch_subject %>" />
            <table class="table">
              <thead><tr><th>#</th><th>Student</th><th>Score (0-100)</th></tr></thead>
              <tbody>
                <% exam_students.forEach((s, i) => { %>
                  <tr>
                    <td><%= i+1 %></td>
                    <td><%= s.full_name %></td>
                    <td><input type="number" class="form-control" style="max-width:120px" name="score[<%= s._id %>]" min="0" max="100" value="<%= existing_scores[s._id.toString()] != null ? existing_scores[s._id.toString()] : '' %>" /></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <button class="btn btn-indigo rounded-3" type="submit">Save Scores</button>
          </form>
        </div>
      <% } %>

    <!-- ===== APPLY LEAVE ===== -->
    <% } else if (page === 'apply_leave') { %>
      <div class="row g-4">
        <div class="col-md-5">
          <div class="card-custom">
            <h6 class="fw-bold mb-3"><i class="fas fa-paper-plane me-2"></i>Apply Leave</h6>
            <form method="POST" action="/app?page=apply_leave">
              <input type="hidden" name="action" value="apply_leave" />
              <div class="mb-3"><label class="form-label">Date</label><input type="date" class="form-control" name="date" required /></div>
              <div class="mb-3"><label class="form-label">Reason</label><textarea class="form-control" name="message" rows="4" required></textarea></div>
              <button class="btn btn-indigo rounded-3 w-100" type="submit">Submit</button>
            </form>
          </div>
        </div>
        <div class="col-md-7">
          <div class="card-custom">
            <h6 class="fw-bold mb-3">My Leave History</h6>
            <table class="table">
              <thead><tr><th>Date</th><th>Reason</th><th>Status</th></tr></thead>
              <tbody>
                <% (my_leaves || []).forEach(l => { %>
                  <tr>
                    <td><%= l.date %></td>
                    <td><%= l.message %></td>
                    <td>
                      <% if (l.status === 'Approved') { %><span class="badge-status badge-approved">Approved</span>
                      <% } else if (l.status === 'Declined') { %><span class="badge-status badge-declined">Declined</span>
                      <% } else { %><span class="badge-status badge-pending">Pending</span><% } %>
                    </td>
                  </tr>
                <% }) %>
                <% if (!(my_leaves && my_leaves.length)) { %>
                  <tr><td colspan="3" class="text-center text-muted py-4">No leave applications yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    <!-- ===== NOTIFICATIONS (admin - leave requests) ===== -->
    <% } else if (page === 'notifications') { %>
      <div class="card-custom">
        <h6 class="fw-bold mb-3"><i class="fas fa-bell me-2"></i>Leave Requests</h6>
        <table class="table">
          <thead><tr><th>Name</th><th>Role</th><th>Date</th><th>Message</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
          <tbody>
            <% (leaves || []).forEach(l => { %>
              <tr>
                <td><%= l.user_id ? l.user_id.full_name : '—' %></td>
                <td><span class="badge bg-primary rounded-pill"><%= l.role %></span></td>
                <td><%= l.date %></td>
                <td><%= l.message %></td>
                <td>
                  <% if (l.status === 'Approved') { %><span class="badge-status badge-approved">Approved</span>
                  <% } else if (l.status === 'Declined') { %><span class="badge-status badge-declined">Declined</span>
                  <% } else { %><span class="badge-status badge-pending">Pending</span><% } %>
                </td>
                <td class="text-end">
                  <% if (l.status === 'Pending') { %>
                    <form method="POST" action="/app?page=notifications" class="d-inline">
                      <input type="hidden" name="action" value="update_leave" />
                      <input type="hidden" name="leave_id" value="<%= l._id %>" />
                      <input type="hidden" name="status" value="Approved" />
                      <button class="btn btn-sm btn-success rounded-3" type="submit"><i class="fas fa-check"></i></button>
                    </form>
                    <form method="POST" action="/app?page=notifications" class="d-inline">
                      <input type="hidden" name="action" value="update_leave" />
                      <input type="hidden" name="leave_id" value="<%= l._id %>" />
                      <input type="hidden" name="status" value="Declined" />
                      <button class="btn btn-sm btn-danger rounded-3" type="submit"><i class="fas fa-times"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (!(leaves && leaves.length)) { %>
              <tr><td colspan="6" class="text-center text-muted py-4">No leave requests.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    <!-- ===== NOTIFY (broadcast) ===== -->
    <% } else if (page === 'notify') { %>
      <div class="card-custom" style="max-width:600px;">
        <h6 class="fw-bold mb-3"><i class="fas fa-bullhorn me-2"></i>Send Notification</h6>
        <form method="POST" action="/app?page=notify">
          <input type="hidden" name="action" value="send_notification" />
          <div class="mb-3"><label class="form-label">Audience</label>
            <select class="form-select" name="type" required>
              <option value="student">Students</option>
              <option value="staff">Staff</option>
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Message</label><textarea class="form-control" name="message" rows="4" required></textarea></div>
          <button class="btn btn-indigo rounded-3 w-100" type="submit">Send</button>
        </form>
      </div>

    <!-- ===== STAFF / STUDENT NOTIFS ===== -->
    <% } else if (page === 'staff_notifs' || page === 'student_notifs') { %>
      <% if (notifs && notifs.length > 0) { %>
        <% notifs.forEach(n => { %>
          <div class="card-custom mb-3 d-flex align-items-start gap-3">
            <div class="icon-circle bg-purple text-white" style="min-width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;">
              <i class="fas fa-bell"></i>
            </div>
            <div>
              <p class="mb-1"><%= n.message %></p>
              <small class="text-muted"><%= new Date(n.created_at).toLocaleString() %></small>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="card-custom text-center text-muted py-5">
          <i class="fas fa-bell-slash fa-2x mb-2"></i>
          <p>No new notices.</p>
        </div>
      <% } %>

    <!-- ===== VIEW ATTENDANCE / MY ATTENDANCE ===== -->
    <% } else if (page === 'view_attendance' || page === 'my_attendance') { %>
      <% const attList = page === 'view_attendance' ? (logs || []) : (my_att || []); %>
      <div class="card-custom">
        <h6 class="fw-bold mb-3"><i class="fas fa-calendar-check me-2"></i>Attendance Records</h6>
        <table class="table">
          <thead>
            <tr>
              <% if (page === 'view_attendance') { %><th>Student</th><% } %>
              <th>Subject</th><th>Date</th><th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% attList.forEach(a => { %>
              <tr>
                <% if (page === 'view_attendance') { %><td><%= a.student_id ? a.student_id.full_name : '—' %></td><% } %>
                <td><%= a.subject_id ? a.subject_id.name : '—' %></td>
                <td><%= a.date %></td>
                <td>
                  <% if (a.status === 'Present') { %><span class="badge-status badge-approved">Present</span>
                  <% } else { %><span class="badge-status badge-declined">Absent</span><% } %>
                </td>
              </tr>
            <% }) %>
            <% if (attList.length === 0) { %>
              <tr><td colspan="<%= page === 'view_attendance' ? 4 : 3 %>" class="text-center text-muted py-4">No records found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    <!-- ===== EXAM RESULTS ===== -->
    <% } else if (page === 'exam_results') { %>
      <% if (scores && scores.length > 0) { %>
        <div class="row g-3">
          <% scores.forEach(s => { %>
            <div class="col-md-4 col-lg-3">
              <div class="score-card" style="border-top: 4px solid #6366F1;">
                <div class="mb-2 text-muted small"><%= s.subject_id ? s.subject_id.name : 'Subject' %></div>
                <div class="score-value"><%= s.score %></div>
                <div class="text-muted small">out of 100</div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="alert alert-info rounded-3"><i class="fas fa-info-circle me-2"></i>No exam scores available yet.</div>
      <% } %>

    <!-- ===== FEEDBACK ===== -->
    <% } else if (page === 'feedback') { %>
      <div class="card-custom" style="max-width:600px;">
        <h6 class="fw-bold mb-3"><i class="fas fa-comment-dots me-2"></i>Submit Feedback</h6>
        <form method="POST" action="/app?page=feedback">
          <input type="hidden" name="action" value="send_feedback" />
          <div class="mb-3"><label class="form-label">Your feedback</label><textarea class="form-control" name="message" rows="5" required></textarea></div>
          <button class="btn btn-indigo rounded-3 w-100" type="submit">Submit</button>
        </form>
      </div>

    <% } else { %>
      <div class="card-custom text-center text-muted py-5">
        <i class="fas fa-exclamation-circle fa-2x mb-2"></i>
        <p>Page not found.</p>
      </div>
    <% } %>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
