<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In · Student Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #F4F7FE;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
    }
    .login-card {
      background: #fff;
      padding: 50px 40px;
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0,0,0,.08);
      max-width: 420px;
      width: 100%;
    }
    .logo-box {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, #FF9C00, #FFC048);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      font-size: 1.4rem;
      margin: 0 auto 20px;
    }
    .login-card h2 {
      font-weight: 700;
      color: #2B3674;
      text-align: center;
      margin-bottom: 4px;
    }
    .login-card .sub {
      color: #A3AED0;
      text-align: center;
      margin-bottom: 28px;
      font-size: .95rem;
    }
    .form-label {
      font-weight: 500;
      color: #2B3674;
      font-size: .9rem;
    }
    .form-control {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: .95rem;
    }
    .form-control:focus {
      border-color: #6366F1;
      box-shadow: 0 0 0 .2rem rgba(99,102,241,.15);
      background: #fff;
    }
    .btn-login {
      background: #6366F1;
      color: #fff;
      border: none;
      border-radius: 12px;
      padding: 12px;
      width: 100%;
      font-weight: 600;
      font-size: 1rem;
      transition: background .2s;
    }
    .btn-login:hover { background: #4F46E5; color: #fff; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="logo-box">S</div>
    <h2>Welcome Back</h2>
    <p class="sub">Student Management System</p>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input id="email" name="email" type="text" class="form-control" placeholder="you@example.com" required />
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input id="password" name="password" type="password" class="form-control" placeholder="••••••••" required />
      </div>
      <button type="submit" class="btn btn-login">Sign In</button>
    </form>
  </div>
</body>
</html>
